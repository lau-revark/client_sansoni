# Postgres connection string. Leave unset to use an embedded PGlite database in ./.data (local dev only).
DATABASE_URL=

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Timezone used for date-range presets (Today, This month, ...)
REPORTING_TZ=Australia/Sydney

# Public base URL, used when generating QR codes
APP_URL=http://localhost:3000

# Payment provider: "mock" until Maxio is connected, then "maxio"
PAYMENT_PROVIDER=mock

# Maxio (Advanced Billing) — fill in when connecting the API
MAXIO_SUBDOMAIN=
MAXIO_API_KEY=
MAXIO_WEBHOOK_SHARED_KEY=
